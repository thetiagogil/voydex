# Browser-safe application runtime configuration. Copy to .env.local.
# Replace these with hosted project values when not using local Supabase.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54621
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Get the local publishable key from `npm run db:status` after `npm run db:start`.
# Private database credentials belong only in ignored .env.database.
