{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voydex",
  "compatibility_date": "2026-11-01",
  /*
   * Plain files only: the app is built as files (`npm run build` writes
   * out/), and Cloudflare hands them out with no Worker script running, so
   * any number of visits stays free. `/codex/pokemon` serves
   * `codex/pokemon.html`; an address with no file gets the 404 page.
   */
  "assets": {
    "directory": "out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
