{
  "css.customData": [".vscode/tailwind-v4.css-data.json"],
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "tailwindCSS.classAttributes": ["class", "className", ".*ClassName"],
  "tailwindCSS.classFunctions": ["cn", "clsx", "cva"],
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#184d80",
    "activityBar.background": "#184d80",
    "activityBar.foreground": "#e7e7e7",
    "activityBar.inactiveForeground": "#e7e7e799",
    "activityBarBadge.background": "#dc4391",
    "activityBarBadge.foreground": "#e7e7e7",
    "commandCenter.border": "#e7e7e799",
    "sash.hoverBorder": "#184d80",
    "statusBar.background": "#103355",
    "statusBar.foreground": "#e7e7e7",
    "statusBarItem.hoverBackground": "#184d80",
    "statusBarItem.remoteBackground": "#103355",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#103355",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#10335599",
    "titleBar.inactiveForeground": "#e7e7e799"
  },
  "peacock.color": "#103355"
}
