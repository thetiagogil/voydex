{
  "name": "voydex",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "overrides": {
    "postcss": "8.5.15"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads",
    "test:watch": "vitest --pool=threads",
    "docs:check": "node scripts/docs/check-docs.mjs",
    "architecture:check": "node scripts/check-architecture.mjs",
    "verify": "npm run docs:check && npm run format:check && npm run lint && npm run typecheck && npm run architecture:check && npm run test && npm run build",
    "verify:all": "npm run db:verify && npm run verify",
    "db:cli:version": "node scripts/database/supabase.mjs --version",
    "db:start": "node scripts/database/supabase.mjs start",
    "db:stop": "node scripts/database/supabase.mjs stop",
    "db:status": "node scripts/database/supabase.mjs status",
    "db:new": "node scripts/database/supabase.mjs migration new",
    "db:migrate:local": "node scripts/database/supabase.mjs migration up --local",
    "db:artifacts:build": "node scripts/database/build-local-artifacts.mjs",
    "db:artifacts:check": "node scripts/database/build-local-artifacts.mjs --check",
    "predb:reset": "npm run db:artifacts:build",
    "db:reset": "node scripts/database/supabase.mjs db reset --local",
    "db:audit": "npm run db:artifacts:check && node scripts/database/audit-schema-files.mjs && node scripts/database/audit-seed-files.mjs",
    "db:format:sql": "node scripts/database/format-sql.mjs --write",
    "db:format:sql:check": "node scripts/database/format-sql.mjs --check",
    "db:lint": "node scripts/database/supabase.mjs db lint --local --fail-on error",
    "db:test": "node scripts/database/supabase.mjs test db --local supabase/tests",
    "db:types": "node scripts/database/generate-types.mjs --local",
    "db:types:check": "node scripts/database/generate-types.mjs --local --check",
    "db:types:linked": "node scripts/database/generate-types.mjs --linked",
    "db:verify": "npm run db:reset && npm run db:audit && npm run db:format:sql:check && npm run db:lint && npm run db:test && npm run db:types:check",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@radix-ui/themes": "^3.3.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.20.0",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.11.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "supabase": "2.105.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
